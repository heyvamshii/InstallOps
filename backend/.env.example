# Copy to backend/.env and fill in. Never commit the real .env.

# Django
DEBUG=True
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token-urlsafe-50
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# PostgreSQL. Neon example:
#   postgresql://user:password@ep-xxx.region.aws.neon.tech/installops?sslmode=require
# Local example:
#   postgresql://postgres:postgres@localhost:5432/installops
# If unset, dev falls back to SQLite with a warning — fine for scaffolding only.
DATABASE_URL=

# Angular dev server
CORS_ALLOWED_ORIGINS=http://localhost:4200
CSRF_TRUSTED_ORIGINS=http://localhost:4200

# Observability (Phase 8) — leave blank to disable
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
APP_VERSION=0.1.0
